# Kinde (OAuth/OIDC) - create an application at https://kinde.com
KINDE_CLIENT_ID=YOUR_CLIENT_ID
KINDE_CLIENT_SECRET=YOUR_CLIENT_SECRET
KINDE_ISSUER_URL=https://YOUR_SUBDOMAIN.kinde.com
KINDE_SITE_URL=http://localhost:5173
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:5173
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:5173

# Backend API and the public URL of this dashboard (used for links sent to guests and crew)
VITE_KASIFY_API_URL=http://localhost:8080
VITE_KASIFY_PUBLIC_URL=http://localhost:5173

# Optional
# VITE_KASIFY_DOCS_URL=https://docs.kasify.eu     # user documentation shown in the menu
# VITE_KASIFY_LEGAL_URL=https://example.com       # site hosting /privacy-policy (guest check-in links to it)
# ANALYTICS_SCRIPT_URL=                           # analytics <script src>, omitted when empty
# AUTH_HINT_COOKIE_DOMAIN=.example.com            # sets a "kasify_auth" hint cookie shared with a marketing site
