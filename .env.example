# Settings for `docker compose up`. Copy to .env and fill in the blanks.
# (For running the API and dashboard without Docker, see README.md.)

# --- Authentication (Kinde, https://kinde.com) ---
# In your Kinde application, allow these URLs:
#   callback: http://localhost:3000   logout: http://localhost:3000
KINDE_DOMAIN=https://YOUR_SUBDOMAIN.kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
# Machine-to-machine application used by the API
KINDE_M2M_CLIENT_ID=
KINDE_M2M_CLIENT_SECRET=

# --- Secrets ---
# Encrypts integration credentials in the database. Generate: openssl rand -base64 32
# Keep it safe: losing it makes stored credentials unreadable.
ENCRYPTION_KEY=

# --- Database (defaults shown; change the password for anything but local use) ---
# POSTGRES_USER=kasify
# POSTGRES_PASSWORD=kasify
# POSTGRES_DB=kasify

# --- Public URL of the dashboard (default http://localhost:3000) ---
# DASHBOARD_BASE_URL=https://app.example.com
# CORS_ALLOWED_HOSTS=app.example.com

# --- Optional ---
# EMAIL_ENABLED=true
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=Kasify <noreply@example.com>
# METRICS_TOKEN=
# VITE_KASIFY_DOCS_URL=https://docs.kasify.eu
# VITE_KASIFY_LEGAL_URL=
