# ========================================
# REQUIRED ENVIRONMENT VARIABLES
# Application will not start without these!
# ========================================

# Sentry
# SENTRY_DSN is required at runtime. Get it from your Sentry project settings.
SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_AUTH_TOKEN=YOUR_TOKEN
SENTRY_DEBUG=true

# Database Configuration (REQUIRED)
DATABASE_URL=jdbc:postgresql://localhost:5432/kasify
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Encryption Configuration (REQUIRED)
# CRITICAL: Generate key with: ./gradlew run --args="generate-key"
# This key encrypts sensitive data (passwords, API tokens) in the database
# NEVER commit the actual key to version control!
ENCRYPTION_KEY=GENERATE_ME

# ========================================
# OPTIONAL ENVIRONMENT VARIABLES
# Defaults will be used if not specified
# ========================================

# Connection Pool Settings (optional - defaults shown)
DB_POOL_SIZE=10        # Maximum number of connections in the pool
DB_MIN_IDLE=2          # Minimum number of idle connections

# Environment (affects leak detection and error messages)
ENVIRONMENT=development  # or 'production'

# Logging Configuration
LOGBACK_LEVEL=DEBUG  # DEBUG, INFO, WARN, ERROR (use INFO for production)
# Console output format. Default is colorized text (good for dev). Set to JSON_STDOUT
# in production for structured logs consumable by Loki / CloudWatch / etc.
# LOG_ROOT_APPENDER=JSON_STDOUT
# LOG_REQ_APPENDER=JSON_STDOUT

# Kinde Authentication Configuration

KINDE_DOMAIN=https://YOUR_SUBDOMAIN.kinde.com
KINDE_M2M_CLIENT_ID=GET_FROM_KINDE
KINDE_M2M_CLIENT_SECRET=GET_FROM_KINDE

# CORS: comma-separated dashboard hosts (no scheme) allowed to call the API.
# Defaults to localhost:5173 when unset.
# CORS_ALLOWED_HOSTS=app.example.com,localhost:5173

# Metrics endpoint protection (optional)
# If not set, /metrics endpoint is disabled entirely
# Access via: /metrics?token=YOUR_SECRET_TOKEN
METRICS_TOKEN=

# Storage (optional - file uploads disabled if not set)
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
BUCKET_PUBLIC=your-public-bucket-name
BUCKET_PUBLIC_URL=https://your-public-bucket-url.example.com
BUCKET_PRIVATE=your-private-bucket-name

# SES Hospedajes (Spanish guest registration)
SES_USERNAME=YOUR_SES_USERNAME
SES_PASSWORD=YOUR_SES_PASSWORD

# RESEND (transactional email)
# When EMAIL_ENABLED is true and RESEND_API_KEY is set, the API sends real emails via Resend;
# otherwise, rendered emails are logged to stdout only (default for local dev and tests).
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_ENABLED=true
EMAIL_FROM_ADDRESS=Kasify <noreply@example.com>
DASHBOARD_BASE_URL=http://localhost:5173

# Rate limiting (see api/CLAUDE.md "Rate Limiting" for the full table of buckets)
# Set to false to disable enforcement (limits will still be logged at startup).
RATE_LIMIT_ENFORCE=true