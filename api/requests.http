@host = http://0.0.0.0:8080
@token = {{pat}}

### Fetch fresh access token using refresh token
# @name getToken
POST https://{{kinde_domain}}/oauth2/token
Content-Type: application/x-www-form-urlencoded

grant_type = refresh_token &
client_id = {{client_id}} &
client_secret = {{client_secret}} &
refresh_token = {{refresh_token}}

> {%
    client.global.set("token", response.body.access_token);
%}

### Create property
POST {{host}}/v1/properties
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Casita6 xxxxxxxxxxxxxxxxxxxxxxx"
}

### Get Properties
GET {{host}}/v1/properties
Authorization: Bearer {{token}}

### Get Property
GET {{host}}/v1/properties/ee1d2ad1-6b74-4da1-98e5-32c1c648c8b6
Authorization: Bearer {{token}}

### Get Tasks
GET {{host}}/v1/tasks
Authorization: Bearer {{token}}

### Get Cleaning Task
GET {{host}}/v1/tasks/18cdeb71-a75c-406e-b9a4-eb531afd2b6e
Authorization: Bearer {{token}}

### Get Single Property
GET {{host}}/v1/properties/20000000-0000-0000-0000-000000000001
Authorization: Bearer {{token}}

### Get Single Property Not Found
GET {{host}}/v1/properties/fe6726ed-d05e-4990-9817-9a9244b9c650
Authorization: Bearer {{token}}

### Get Single Error
GET {{host}}/v1/properties/propertytest
Authorization: Bearer {{token}}

############
### SES HOSPEDAJES (admin, requires "admin" role)
@bookingId = 40000000-0000-0000-0000-000000000001
@sesCommunicationId = 00000000-0000-0000-0000-000000000000

### Get a booking's SES audit log (submissions + communications)
GET {{host}}/v1/admin/ses/bookings/{{bookingId}}/submissions
Authorization: Bearer {{token}}

### Submit the booking's Parte de Viajeros (PV) to SES
# 200 accepted · 202 rejected by SES · 409 not eligible (no_integration, no_establishment_code,
# no_checkin_completed, already_submitted, before_checkin, no_guests, cancelled)
# On acceptance also writes the libro-registro entry (guest_registry_entries).
POST {{host}}/v1/admin/ses/bookings/77a6777f-6078-40e7-a2e9-137aadb5713c/submit
Authorization: Bearer {{token}}

### Submit the booking's Reserva de Hospedaje (RH) to SES (direct bookings only)
POST {{host}}/v1/admin/ses/bookings/{{bookingId}}/submit-rh
Authorization: Bearer {{token}}

### Poll a communication's estado (consultaLote) — mirrors the result onto the libro-registro entry
POST {{host}}/v1/admin/ses/communications/{{sesCommunicationId}}/poll
Authorization: Bearer {{token}}

### Get Property Events
GET {{host}}/v1/properties/20000000-0000-0000-0000-000000000001/calendar
Authorization: Bearer {{token}}

